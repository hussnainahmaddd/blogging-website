ildren":"Milestone"}],": The Anatomy Scan (see below)."]}],"\n"]}],"\n",["$","h3","h3-2",{"children":"Month 6 (Weeks 22-27): Viability"}],"\n",["$","ul","ul-2",{"children":["\n","$L19","\n","$L1a","\n"]}],"\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39"],"$L3a"]}]]}],"$L3b","$L3c"]
